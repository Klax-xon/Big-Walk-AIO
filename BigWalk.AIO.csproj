<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<AssemblyName>BigWalk.AIO</AssemblyName>
		<RootNamespace>BigWalk.AIO</RootNamespace>
		<OutputType>Library</OutputType>
		<PlatformTarget>x64</PlatformTarget>
		<LangVersion>preview</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>disable</Nullable>
		<DefineConstants>IL2CPP</DefineConstants>

		<OutputPath Condition="'$(OutputPath)' == ''">bin\$(Configuration)\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>embedded</DebugType>
		<Optimize>true</Optimize>

		<!-- Optional Game directory resolution (configured for Big Walk) -->
		<GameRoot Condition="'$(GameRoot)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Big Walk</GameRoot>
		<BepInExRoot Condition="'$(BepInExRoot)' == '' and Exists('$(GameRoot)\BepInEx')">$(GameRoot)\BepInEx</BepInExRoot>
	</PropertyGroup>

	<ItemGroup>
		<!-- BepInEx 6 & IL2CPP Interop Core -->
		<Reference Include="BepInEx.Core">
			<HintPath Condition="Exists('$(BepInExRoot)\core\BepInEx.Core.dll')">$(BepInExRoot)\core\BepInEx.Core.dll</HintPath>
			<HintPath Condition="!Exists('$(BepInExRoot)\core\BepInEx.Core.dll')">libs\BepInEx.Core.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="BepInEx.Unity.IL2CPP">
			<HintPath Condition="Exists('$(BepInExRoot)\core\BepInEx.Unity.IL2CPP.dll')">$(BepInExRoot)\core\BepInEx.Unity.IL2CPP.dll</HintPath>
			<HintPath Condition="!Exists('$(BepInExRoot)\core\BepInEx.Unity.IL2CPP.dll')">libs\BepInEx.Unity.IL2CPP.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="BepInEx.Unity.Common">
			<HintPath Condition="Exists('$(BepInExRoot)\core\BepInEx.Unity.Common.dll')">$(BepInExRoot)\core\BepInEx.Unity.Common.dll</HintPath>
			<HintPath Condition="!Exists('$(BepInExRoot)\core\BepInEx.Unity.Common.dll')">libs\BepInEx.Unity.Common.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Il2CppInterop.Runtime">
			<HintPath Condition="Exists('$(BepInExRoot)\core\Il2CppInterop.Runtime.dll')">$(BepInExRoot)\core\Il2CppInterop.Runtime.dll</HintPath>
			<HintPath Condition="!Exists('$(BepInExRoot)\core\Il2CppInterop.Runtime.dll')">libs\Il2CppInterop.Runtime.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Il2CppInterop.Common">
			<HintPath Condition="Exists('$(BepInExRoot)\core\Il2CppInterop.Common.dll')">$(BepInExRoot)\core\Il2CppInterop.Common.dll</HintPath>
			<HintPath Condition="!Exists('$(BepInExRoot)\core\Il2CppInterop.Common.dll')">libs\Il2CppInterop.Common.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Il2Cppmscorlib">
			<HintPath Condition="Exists('$(BepInExRoot)\interop\Il2Cppmscorlib.dll')">$(BepInExRoot)\interop\Il2Cppmscorlib.dll</HintPath>
			<HintPath Condition="!Exists('$(BepInExRoot)\interop\Il2Cppmscorlib.dll')">libs\Il2Cppmscorlib.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Il2CppSystem.Core">
			<HintPath Condition="Exists('$(BepInExRoot)\interop\Il2CppSystem.Core.dll')">$(BepInExRoot)\interop\Il2CppSystem.Core.dll</HintPath>
			<HintPath Condition="!Exists('$(BepInExRoot)\interop\Il2CppSystem.Core.dll')">libs\Il2CppSystem.Core.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<!-- Dear ImGui Presentation Foundation -->
		<Reference Include="DearImGuiInjectionPlus">
