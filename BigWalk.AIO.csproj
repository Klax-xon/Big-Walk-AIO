		<Reference Include="Enviro3.Runtime">
			<HintPath Condition="Exists('$(BepInExRoot)\interop\Enviro3.Runtime.dll')">$(BepInExRoot)\interop\Enviro3.Runtime.dll</HintPath>
			<HintPath Condition="!Exists('$(BepInExRoot)\interop\Enviro3.Runtime.dll')">libs\Enviro3.Runtime.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Rewired_Core">
			<HintPath Condition="Exists('$(BepInExRoot)\interop\Rewired_Core.dll')">$(BepInExRoot)\interop\Rewired_Core.dll</HintPath>
			<HintPath Condition="!Exists('$(BepInExRoot)\interop\Rewired_Core.dll')">libs\Rewired_Core.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Rewired_Windows">
			<HintPath Condition="Exists('$(BepInExRoot)\interop\Rewired_Windows.dll')">$(BepInExRoot)\interop\Rewired_Windows.dll</HintPath>
			<HintPath Condition="!Exists('$(BepInExRoot)\interop\Rewired_Windows.dll')">libs\Rewired_Windows.dll</HintPath>
			<Private>False</Private>
		</Reference>

		<!-- Unity Engine Modules -->
		<Reference Include="UnityEngine">
			<HintPath Condition="Exists('$(BepInExRoot)\interop\UnityEngine.dll')">$(BepInExRoot)\interop\UnityEngine.dll</HintPath>
			<HintPath Condition="!Exists('$(BepInExRoot)\interop\UnityEngine.dll')">libs\UnityEngine.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath Condition="Exists('$(BepInExRoot)\interop\UnityEngine.CoreModule.dll')">$(BepInExRoot)\interop\UnityEngine.CoreModule.dll</HintPath>
			<HintPath Condition="!Exists('$(BepInExRoot)\interop\UnityEngine.CoreModule.dll')">libs\UnityEngine.CoreModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.PhysicsModule">
