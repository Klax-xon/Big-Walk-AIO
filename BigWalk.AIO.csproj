	</ItemGroup>

	<!-- Optional automatic deployment to local game installation -->
	<Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GameRoot)\BepInEx\plugins')">
		<ItemGroup>
			<PluginOutputFiles Include="$(TargetDir)$(TargetName).dll;$(TargetDir)$(TargetName).pdb" />
		</ItemGroup>
		<MakeDir Directories="$(GameRoot)\BepInEx\plugins\Big-Walk-AIO\" />
		<Copy SourceFiles="@(PluginOutputFiles)" DestinationFolder="$(GameRoot)\BepInEx\plugins\Big-Walk-AIO\" SkipUnchangedFiles="true" />
		<Message Importance="high" Text="Successfully deployed $(TargetName) to $(GameRoot)\BepInEx\plugins\Big-Walk-AIO\" />
	</Target>

</Project>
