			<HintPath Condition="Exists('$(BepInExRoot)\interop\Shipmates.Utilities.dll')">$(BepInExRoot)\interop\Shipmates.Utilities.dll</HintPath>
			<HintPath Condition="!Exists('$(BepInExRoot)\interop\Shipmate.Utilities.dll') and !Exists('$(BepInExRoot)\interop\Shipmates.Utilities.dll')">libs\Shipmate.Utilities.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Mirror">
			<HintPath Condition="Exists('$(BepInExRoot)\interop\Mirror.dll')">$(BepInExRoot)\interop\Mirror.dll</HintPath>
			<HintPath Condition="!Exists('$(BepInExRoot)\interop\Mirror.dll')">libs\Mirror.dll</HintPath>
			<Private>False</Private>
